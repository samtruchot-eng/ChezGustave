# ------------------------------------------------------------------
# Chez Gustave — variables d'environnement (exemple)
# Copiez ce fichier vers `.env` et complétez les valeurs.
# ------------------------------------------------------------------

# Base de données
# Dev local : SQLite (aucune installation nécessaire)
DATABASE_URL="file:./dev.db"
# Production : PostgreSQL (ex. Neon, Supabase, Railway)
# DATABASE_URL="postgresql://user:password@host:5432/chezgustave?schema=public"

# Auth.js / NextAuth
# Générez un secret : `openssl rand -base64 32`
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"
# URL publique de l'app
NEXTAUTH_URL="http://localhost:3000"

# Stripe (paiements + commission plateforme via Stripe Connect)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Commission plateforme (en pourcentage, ex. 18 = 18 %)
PLATFORM_COMMISSION_PERCENT="18"
