# ------------------------------------------------------------------
# Chez Gustave — variables d'environnement (exemple)
# Copiez ce fichier vers `.env` et complétez les valeurs.
# ------------------------------------------------------------------

# Base de données — PostgreSQL (obligatoire)
# En local comme en production, utilisez une base Postgres.
# Le plus simple : créer une base gratuite sur Neon (https://neon.tech)
# et coller ici la "connection string".
# Astuce : utilisez la chaîne DIRECTE (non "pooled") pour un prototype.
DATABASE_URL="postgresql://user:password@host.neon.tech/chezgustave?sslmode=require"

# Auth.js / NextAuth (pour l'étape authentification)
# Générez un secret : `openssl rand -base64 32`
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (paiements + commission via Stripe Connect — étape suivante)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Commission plateforme (en pourcentage, ex. 18 = 18 %)
PLATFORM_COMMISSION_PERCENT="18"

# Administrateurs : e-mails (séparés par des virgules) ayant accès à /admin.
# Le compte doit exister (inscription normale) ; son e-mail ici le rend admin.
ADMIN_EMAILS="s.truchot@brocher.ch"

# (Optionnel) Active la route /api/seed pour remplir la base de démo depuis
# une URL : GET /api/seed?key=VOTRE_SECRET . Laissez vide pour la désactiver.
# ⚠️ Réinitialise les données. À retirer une fois l'aperçu peuplé.
SEED_SECRET=""
